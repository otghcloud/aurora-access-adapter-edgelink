{
    "name": "otghcloud/aurora-access-adapter-edgelink",
    "description": "EdgeLink adapter integration package for Access Control",
    "type": "library",
    "license": "MIT",
    "require": {
        "otghcloud/aurora-access-core": "*@dev",
        "otghcloud/laravel-edgelink": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "OTGH\\AccessControl\\EdgelinkAdapter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OTGH\\AccessControl\\EdgelinkAdapter\\EdgelinkAdapterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
